import java.util.Scanner;

public class SalaryTransformationSystem {

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        // Employee details
        System.out.println("===== SALARY TRANSFORMATION SYSTEM =====");

        System.out.print("Enter Employee ID: ");
        int employeeId = sc.nextInt();
        sc.nextLine();

        System.out.print("Enter Employee Name: ");
        String name = sc.nextLine();

        System.out.print("Enter Department: ");
        String department = sc.nextLine();

        System.out.print("Enter Designation: ");
        String designation = sc.nextLine();

        // Salary details
        System.out.print("Enter Basic Salary: ");
        double basicSalary = sc.nextDouble();

        // Allowances
        double hra = basicSalary * 0.40;   // 40% HRA
        double da = basicSalary * 0.20;    // 20% DA

        System.out.print("Enter Other Allowances: ");
        double otherAllowance = sc.nextDouble();

        System.out.print("Enter Bonus: ");
        double bonus = sc.nextDouble();

        // Gross salary
        double grossSalary = basicSalary + hra + da
                + otherAllowance + bonus;

        // Deductions
        double pf = basicSalary * 0.12;    // 12% PF

        System.out.print("Enter Tax Deduction: ");
        double tax = sc.nextDouble();

        System.out.print("Enter Other Deductions: ");
        double otherDeduction = sc.nextDouble();

        // Total deductions
        double totalDeduction = pf + tax + otherDeduction;

        // Net salary
        double netSalary = grossSalary - totalDeduction;

        // Display salary details
        System.out.println("\n========================================");
        System.out.println("          EMPLOYEE SALARY SLIP");
        System.out.println("========================================");

        System.out.println("Employee ID     : " + employeeId);
        System.out.println("Employee Name   : " + name);
        System.out.println("Department      : " + department);
        System.out.println("Designation     : " + designation);

        System.out.println("----------------------------------------");
        System.out.println("Basic Salary    : ₹" + basicSalary);
        System.out.println("HRA             : ₹" + hra);
        System.out.println("DA              : ₹" + da);
        System.out.println("Other Allowance : ₹" + otherAllowance);
        System.out.println("Bonus           : ₹" + bonus);

        System.out.println("----------------------------------------");
        System.out.println("Gross Salary    : ₹" + grossSalary);

        System.out.println("\nDeductions");
        System.out.println("PF              : ₹" + pf);
        System.out.println("Tax             : ₹" + tax);
        System.out.println("Other Deduction : ₹" + otherDeduction);
        System.out.println("Total Deduction : ₹" + totalDeduction);

        System.out.println("----------------------------------------");
        System.out.println("NET SALARY      : ₹" + netSalary);
        System.out.println("========================================");

        sc.close();
    }
}

