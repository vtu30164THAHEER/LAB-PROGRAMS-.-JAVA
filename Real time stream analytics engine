import java.util.Scanner;

public class RealTimeStreamAnalytics {

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int totalEvents = 0;
        double totalValue = 0;
        double maxValue = Double.MIN_VALUE;
        double minValue = Double.MAX_VALUE;

        System.out.println("==========================================");
        System.out.println("     REAL-TIME STREAM ANALYTICS ENGINE");
        System.out.println("==========================================");

        System.out.print("Enter number of events: ");
        int n = sc.nextInt();

        for (int i = 1; i <= n; i++) {

            System.out.println("\nEvent " + i);

            System.out.print("Enter Event ID: ");
            int eventId = sc.nextInt();

            System.out.print("Enter Sensor Value: ");
            double value = sc.nextDouble();

            // Process stream data
            totalEvents++;
            totalValue += value;

            if (value > maxValue) {
                maxValue = value;
            }

            if (value < minValue) {
                minValue = value;
            }

            // Display real-time result
            System.out.println("Event ID     : " + eventId);
            System.out.println("Value        : " + value);

            // Alert detection
            if (value > 80) {
                System.out.println("ALERT: High value detected!");
            } else if (value < 20) {
                System.out.println("ALERT: Low value detected!");
            } else {
                System.out.println("Status       : Normal");
            }

            double average = totalValue / totalEvents;

            System.out.println("Current Average: " + average);
        }

        // Final analytics
        double average = totalValue / totalEvents;

        System.out.println("\n==========================================");
        System.out.println("          STREAM ANALYTICS REPORT");
        System.out.println("==========================================");

        System.out.println("Total Events    : " + totalEvents);
        System.out.println("Total Value     : " + totalValue);
        System.out.println("Average Value   : " + average);
        System.out.println("Maximum Value   : " + maxValue);
        System.out.println("Minimum Value   : " + minValue);

        System.out.println("==========================================");
        System.out.println("Analytics completed successfully.");
        System.out.println("==========================================");

        sc.close();
    }
}

